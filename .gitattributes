# Shell scripts must use LF line endings. core.autocrlf=true would otherwise
# convert them to CRLF on checkout, which breaks bash on Windows Git Bash
# (stray \r corrupts commands and string comparisons). This applies to the
# .claude/hooks/*.sh hooks and .claude/scripts/*.sh.
*.sh text eol=lf

# awk programs the helpers read with `awk -f` (yaml-get.awk). Git Bash gawk
# tolerates CRLF; mawk and BWK awk may not, so they are checked out LF too.
*.awk text eol=lf

# .worktreeinclude is a pattern list Claude Code reads when it creates a
# worktree. A CRLF checkout would end every pattern in \r, and a parser that
# does not strip it matches nothing, so the local config is silently not copied.
.worktreeinclude text eol=lf

# Tabular data is compared byte-for-byte by tooling that diffs it against
# freshly-generated output (which is always LF). A CRLF checkout would make
# every line differ, silently breaking any such comparison.
*.tsv text eol=lf

# Markdown under .claude/ is authored LF. Two concrete reasons:
#   - tooling that flattens SKILL.md files and substring-matches sentences
#     breaks on a stray \r mid-sentence: every multi-line match fails, and
#     the tooling then reports rules as lost that are present.
#   - a CRLF file produces a whole-file diff the first time anyone edits it,
#     which buries real changes.
# .gitattributes governs the INDEX. It does not retro-fix a working tree that
# predates the rule -- run `git add --renormalize .` for that.
.claude/**/*.md text eol=lf

# ---------------------------------------------------------------- Unity + art pipeline
# Unity YAML (Force Text serialization): LF text, smart merge
*.unity        text eol=lf merge=unityyamlmerge
*.prefab       text eol=lf merge=unityyamlmerge
*.mat          text eol=lf merge=unityyamlmerge
*.anim         text eol=lf merge=unityyamlmerge
*.controller   text eol=lf merge=unityyamlmerge
*.overrideController text eol=lf merge=unityyamlmerge
*.physicMaterial text eol=lf merge=unityyamlmerge
# .asset can be YAML or binary (TerrainData, LightingData): let git detect, never convert line endings
*.asset        merge=unityyamlmerge
*.meta         text eol=lf
*.terrainlayer text eol=lf
*.lighting     text eol=lf
*.inputactions text eol=lf
*.cs           text eol=lf diff=csharp
*.shader       text eol=lf
*.hlsl         text eol=lf
*.uss          text eol=lf
*.uxml         text eol=lf
*.json         text eol=lf
*.py           text eol=lf

# Large binaries: Git LFS (run `git lfs install` once per machine; tools/new_project.sh does it)
*.blend   filter=lfs diff=lfs merge=lfs -text
*.fbx     filter=lfs diff=lfs merge=lfs -text
*.FBX     filter=lfs diff=lfs merge=lfs -text
*.glb     filter=lfs diff=lfs merge=lfs -text
*.png     filter=lfs diff=lfs merge=lfs -text
*.jpg     filter=lfs diff=lfs merge=lfs -text
*.jpeg    filter=lfs diff=lfs merge=lfs -text
*.tga     filter=lfs diff=lfs merge=lfs -text
*.tif     filter=lfs diff=lfs merge=lfs -text
*.psd     filter=lfs diff=lfs merge=lfs -text
*.exr     filter=lfs diff=lfs merge=lfs -text
*.hdr     filter=lfs diff=lfs merge=lfs -text
*.wav     filter=lfs diff=lfs merge=lfs -text
*.mp3     filter=lfs diff=lfs merge=lfs -text
*.ogg     filter=lfs diff=lfs merge=lfs -text
*.mp4     filter=lfs diff=lfs merge=lfs -text
*.ttf     filter=lfs diff=lfs merge=lfs -text
*.otf     filter=lfs diff=lfs merge=lfs -text
# Always-binary Unity assets
*LightingData.asset  filter=lfs diff=lfs merge=lfs -text
*TerrainData*.asset  binary
*OcclusionCullingData.asset binary
*.bytes binary
